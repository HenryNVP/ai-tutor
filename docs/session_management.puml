@startuml Session_Management_Flow
skinparam wrapWidth 240
title Session Management & Component Communication

actor User
participant "Streamlit UI\nor FastAPI Client" as Client
participant "TutorService\n(Service Layer)" as Service
participant "TutorAgent\n(Orchestrator)" as Agent
participant "AgentState\n(Shared State)" as State
participant "SQLiteSession\n(OpenAI Agents SDK)" as Session
database "sessions.sqlite\n(data/processed)" as DB

group Session Initialization
User -> Client : Request (question/quiz/note)
Client -> Service : process_event(session_id, event)
Service -> Agent : answer_question(learner_id, question)
Agent -> Agent : _get_session(learner_id)

alt Session exists in cache
    Agent -> Agent : Return cached session
else Session not in cache
    Agent -> Agent : Generate session key:\nai_tutor_<learner_id>_<YYYYMMDD>_<batch>
    Agent -> Session : Load/create SQLiteSession
    Session -> DB : Query/create session record
    Agent -> Agent : Cache in memory
end
end

group Routing & Execution
Agent -> Agent : apply_deterministic_routing()\nor _route_with_llm()
Agent -> Agent : _execute_decision()
Agent -> Agent : Route to specialist agent\n(QA/Web/Quiz/Note)

alt QA Agent
    Agent -> Agent : build_qa_agent()
    Agent -> State : Store results in AgentState
    State -> State : last_hits, last_citations
else Quiz Agent
    Agent -> Agent : build_quiz_agent()
    Agent -> State : Store quiz in AgentState
    State -> State : last_quiz
else Web Agent
    Agent -> Agent : build_web_agent()
    Agent -> State : Store web results
    State -> State : last_source = "web"
end
end

group Response Assembly
Agent -> State : Collect results from AgentState
Agent -> Agent : Format TutorResponse
Agent -> Session : Save conversation turn
Session -> DB : Persist to SQLite
Agent -> State : Reset AgentState for next query
Agent -> Service : Return TutorResponse
Service -> Client : Return SessionResponse
Client -> User : Display response
end

group Session Rotation
note right of Session
  Automatic Rotation:
  
  1. Daily Rotation:
     - New session key each day
     - Format: ai_tutor_<learner_id>_<YYYYMMDD>_<batch>
     - Prevents token accumulation
  
  2. Turn-Based Pruning:
     - New session after max_turns_per_session (default: 3)
     - Only last 3 turns kept in context
     - Prevents prompt poisoning
  
  3. Manual Clearing:
     - POST /sessions/<id>/reset
     - clear_conversation_history(learner_id)
     - Script: clear_sessions.py
end note
end

group Component Communication Pattern
participant "Specialist Agent\n(QA/Web/Quiz/Note)" as Specialist
participant "AgentState\n(Shared Mutable State)" as SharedState
participant "Orchestrator\n(TutorAgent)" as Orchestrator

Specialist -> SharedState : Store results\n(last_hits, last_citations, last_quiz)
Orchestrator -> SharedState : Read results
Orchestrator -> SharedState : Reset for next query

note right of SharedState
  AgentState Pattern:
  
  • Loose coupling between agents
  • No direct agent-to-agent calls
  • Centralized result collection
  • Easy to add new agents
  
  State Fields:
  - last_hits: List[RetrievalHit]
  - last_citations: List[str]
  - last_source: Optional[str]
  - last_quiz: Optional[Quiz]
end note
end

@enduml

@startuml API_Request_Flow
skinparam wrapWidth 220
title FastAPI Request Flow

actor Client
participant "FastAPI App\n(apps/api.py)" as API
participant "TutorService\n(Singleton)" as Service
participant "TutorSystem\n(Core Facade)" as System
participant "TutorAgent\n(Orchestrator)" as Agent
participant "Specialist Agent" as Specialist
database "Session Storage" as SessionDB
database "Vector Store" as VectorDB

group Standard Request Flow
Client -> API : POST /answer\n(learner_id, question, ...)
API -> API : Validate request (Pydantic)
API -> Service : get_service() [@lru_cache singleton]
Service -> System : answer_question(learner_id, question)
System -> Agent : answer(learner_id, question, ...)
Agent -> Agent : _get_session(learner_id)
Agent -> SessionDB : Load/create session
Agent -> Agent : Route to specialist agent
Agent -> Specialist : Execute (QA/Web/Quiz/Note)
Specialist -> VectorDB : Retrieve (if needed)
Specialist -> Agent : Return results via AgentState
Agent -> Agent : Format TutorResponse
Agent -> SessionDB : Save conversation turn
Agent -> System : Return TutorResponse
System -> Service : Return TutorResponse
Service -> API : Serialize to JSON
API -> Client : HTTP 200 + JSON response
end

group Session Event Flow
Client -> API : POST /sessions/<learner_id>/events\n(event: type, content, ...)
API -> Service : process_event(session_id, event)
Service -> Service : _build_prompt_from_event()
Service -> Service : retrieve_from_uploaded_documents()\n(if source_hints provided)
Service -> System : answer_question(learner_id, question, ...)
System -> Agent : [Standard flow above]
Agent -> Service : Return TutorResponse
Service -> Service : Convert to SessionResponse
Service -> Service : Store in session history
Service -> API : Return SessionResponse
API -> Client : HTTP 200 + SessionResponse
end

group Error Handling
alt Error occurs
    Specialist -> Agent : Raise exception
    Agent -> System : Propagate exception
    System -> Service : Propagate exception
    Service -> API : Raise HTTPException(status_code=500)
    API -> Client : HTTP 500 + error details
else Validation error
    API -> API : Pydantic validation fails
    API -> Client : HTTP 422 + validation errors
end
end

note right of Service
  Service Layer Benefits:
  
  • Abstraction between UI and core
  • Shared singleton for all requests
  • MCP connections cached
  • Tool lists cached per session
  • Error handling and logging
  • Session event processing
end note

note right of API
  API Features:
  
  • CORS middleware (configurable)
  • Async execution (asyncio.to_thread)
  • Background tasks (temp file cleanup)
  • Health check endpoint
  • Comprehensive error handling
  • Request/response validation (Pydantic)
end note

@enduml

